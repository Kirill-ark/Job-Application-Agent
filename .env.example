# Copy to .env and fill in. Never commit .env.

# Groq API key (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Model used by the agent (checked against Groq's model list in step 8)
GROQ_MODEL=

# SQLite database file
DATABASE_PATH=data/job_agent.db

# Public demo protection
RUNS_PER_IP_PER_DAY=5
LLM_CALLS_PER_DAY=500
