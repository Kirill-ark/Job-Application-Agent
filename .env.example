# Copy to .env and fill in. Never commit .env.

# Groq API key (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Model used by the agent and for match reasons. List: https://console.groq.com/docs/models
# It must support several tool calls in one step (on Groq, gpt-oss does not).
GROQ_MODEL=qwen/qwen3.8-27b

# Model for cover letters. Groq limits tokens per minute per model, so a second
# model doubles the budget of one agent run.
GROQ_LETTER_MODEL=openai/gpt-oss-120b

# CV served by the MCP server (default: the example CV)
CV_PATH=data/cv.yaml

# SQLite database file
DATABASE_PATH=data/job_agent.db

# Public demo protection. Groq's free tier allows 200,000 tokens per day per model
# and one run costs 10,000-23,000, so about 10 runs a day fit for everyone.
RUNS_PER_IP_PER_DAY=3
RUNS_PER_DAY=10
# Secret salt for hashing visitors' IPs (any long random string). IPs are never stored.
IP_HASH_SALT=
# 1 only behind a proxy that sets X-Forwarded-For (Render does)
TRUST_PROXY_HEADERS=0
